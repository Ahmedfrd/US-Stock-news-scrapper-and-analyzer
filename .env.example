# Copy this file to ".env" and fill in the keys you have.
#   cp .env.example .env
# The .env file is git-ignored — it stays on your machine, never uploaded.
# Leave any line blank/removed to skip that feature (the tool degrades gracefully).

# --- AI analysis (at least one recommended; Gemini is the default) ---
# Gemini's free tier is rate-limited (429s), so add up to 3 keys from separate
# Google accounts — each has its own quota. GEMINI_API_KEY is tried first; _2 and
# _3 are the last-resort backups, tried automatically only when the one before is
# rate-limited. (In GitHub Actions, add these as repo secrets of the same names.)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Data ---
# Optional: richer bullish/bearish %25 crowd sentiment (free 250 req/mo). Without it,
# crowd sentiment still works via ApeWisdom (Reddit mentions + trend, no key).
ADANOS_API_KEY=

FINNHUB_API_KEY=
# SEC asks automated requests to identify themselves. Use your real name + email.
SEC_USER_AGENT=Your Name your@email.com

# --- Delivery (only if you set delivery.method to email / telegram) ---
EMAIL_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
